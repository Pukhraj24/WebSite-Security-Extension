{
  "manifest_version": 3,
  "name": "Website Security & Cookie Analyzer",
  "version": "1.0.0",
  "description": "Analyzes website transport security, TLS certificates, security headers, and cookie configurations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze Website Security",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
